POSTGRES_DB=vietclass
POSTGRES_USER=vietclass
POSTGRES_PASSWORD=vietclass_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Address the local API and frontend bind to. 0.0.0.0 is required on WSL2 so a
# browser on the Windows host can reach them as app.lvh.me / api.lvh.me; on native
# Linux or macOS 127.0.0.1 is enough.
DEV_BIND_HOST=0.0.0.0

# Port the Laravel dev server listens on. Moved off 8000 because another local
# project already uses it; must match the port in frontend/.env.local.
DEV_API_PORT=8000

POSTGRES_DB=vietclass
POSTGRES_USER=vietclass
POSTGRES_PASSWORD=vietclass_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Address the local API and frontend bind to. 0.0.0.0 is required on WSL2 so a
# browser on the Windows host can reach the app; on native Linux or macOS
# 127.0.0.1 is enough. The browser uses the same-origin Next.js BFF, so no API
# hostname or /etc/hosts entry is required.
DEV_BIND_HOST=0.0.0.0

# Port the Laravel dev server listens on. Must match the port in
# frontend/.env.local API_BASE_URL. Change it here and there together if another
# local project already holds 8000.
DEV_API_PORT=8000

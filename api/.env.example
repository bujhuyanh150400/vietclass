APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vietclass
DB_USERNAME=vietclass
DB_PASSWORD=vietclass_dev_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# The API lives on api.<domain> while the app lives on <domain>, so the session
# cookie needs the shared parent domain to reach both. Production: .vietclass.vn
# Development: .vietclass.test — add to the Windows hosts file:
#   127.0.0.1 app.vietclass.test api.vietclass.test
# so app.* and api.* are cross-origin but same-site, exactly as production will be.
SESSION_DOMAIN=.vietclass.test
# Must be true in production: the session cookie carries the API token.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated exact origins allowed to send the session cookie. Never a
# wildcard: credentialed CORS requires naming each origin. Production:
# https://vietclass.vn
CORS_ALLOWED_ORIGINS=http://app.vietclass.test:3000
CORS_MAX_AGE=600
IDENTITY_TOKEN_NAME=api-client
IDENTITY_TOKEN_EXPIRATION_DAYS=30
IDENTITY_REMEMBER_TOKEN_EXPIRATION_DAYS=120
IDENTITY_SESSION_COOKIE=vietclass_token

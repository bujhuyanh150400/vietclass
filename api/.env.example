APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vietclass
DB_USERNAME=vietclass
DB_PASSWORD=vietclass_dev_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Laravel's framework session cookie is not used for API authentication. Keep it
# host-only; bearer tokens are sent in Authorization headers by API clients/BFF.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk holding uploaded files. Set to r2 in production; local keeps them under
# storage/app/private, which no deployed instance should serve.
SYSTEM_FILES_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 bucket holding uploaded files. The bucket must stay private: file
# content is only ever served through /api/v1/system/files/{file}/content, which checks
# permissions and then redirects to a five-minute signed URL. Use a token scoped to
# this one bucket with object read, write and delete only — no account-wide or
# bucket-administration permission — and never expose a public bucket URL.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Trashed files are purged 30 days after they are trashed by the files:purge-trash
# command, scheduled daily. It runs only if the deployment calls
# `php artisan schedule:run` every minute; no queue or worker process is needed.

VITE_APP_NAME="${APP_NAME}"

# Comma-separated exact origins allowed to call the API directly with Bearer auth.
# Never use a wildcard. Production example:
# https://vietclass.vn
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_MAX_AGE=600
AUTH_TOKEN_NAME=api-client
AUTH_TOKEN_EXPIRATION_DAYS=30
AUTH_REMEMBER_TOKEN_EXPIRATION_DAYS=120
